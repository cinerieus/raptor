#!/usr/bin/env python3
# ruff: noqa: RUF100, I001
# (preamble protection; see .github/tests/test_libexec_marker_coverage.py)
"""
raptor-run-sandboxed — execute a binary inside the full sandbox.

Usage: raptor-run-sandboxed <binary> [args...]

Isolation applied:
- Network blocked (unshare --user --net)
- Filesystem write restriction (Landlock)
- Resource limits (memory, file size, CPU time)

Deliberately NOT applied (unlike raptor-r2-sandboxed): read
restriction and HOME masking. This wrapper's mandated use is
arbitrary untrusted BUILD systems (configure/make/PoC compiles),
whose read surface — toolchains, caches, system headers — is not
enumerable up front; restrict_reads would fail-closed unpredictable
subsets of legitimate builds. Consequence the caller must own: the
child can READ any world-readable file, including the operator's
real HOME. Do not point downstream agents at OUTPUT_DIR contents as
trusted, and do not use this wrapper when read confinement matters —
use the r2 wrapper's posture as the template instead.

Falls back gracefully when features are unavailable.

Environment:
- OUTPUT_DIR (required): writable directory for the sandboxed child. Must
  be set explicitly — there is no safe default (using /tmp would let
  the child write anywhere in /tmp, which defeats isolation). Set to a
  dedicated per-invocation directory.
- RAPTOR_SANDBOX_TIMEOUT (optional): child wall-clock limit in seconds
  (default 1800). ASAN builds of large projects routinely exceed 30
  minutes; raise per-run instead of editing this file.

stdout/stderr pass through directly so the caller (including LLM agents)
sees the child's output. Sandbox diagnostics and structured errors are
printed to stderr prefixed `[sandbox] ` after the child exits.

Exit codes:
- Child's returncode on successful invocation
- 1 on misuse (missing args, missing OUTPUT_DIR)
- 2 on sandbox invocation failure (unshare, kernel, timeout, etc.)
- 3 when sandbox isolation could not ENGAGE (SandboxSetupError — the
  child never executed; SANDBOX_ENGAGE_EXIT_CODE convention)
"""

import logging
import subprocess
import sys

# RAPTOR imports
raptor_dir = str(__import__("pathlib").Path(__file__).resolve().parents[1])  # libexec -> raptor

# ─── trust-marker check (do not import; inline by design) ───
# fmt: off
import os  # noqa: E402
if not (os.environ.get("CLAUDECODE")
        or os.environ.get("_RAPTOR_TRUSTED")):
    sys.stderr.write(
        f"{sys.argv[0]}: internal dispatch script.\n"
        "  Run via 'bin/raptor' instead.\n"
        "  Tests / power users: set _RAPTOR_TRUSTED=1 to bypass.\n"
    )
    sys.exit(2)
# fmt: on
# ─── end trust-marker check ─────────────────────────────────

sys.path.insert(0, raptor_dir)
import core.startup.process_init  # noqa: E402,F401


def _die(msg: str, code: int = 1) -> None:
    print(f"[sandbox] ERROR: {msg}", file=sys.stderr)
    sys.exit(code)


if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
    usage = (
        "Usage: raptor-run-sandboxed <binary> [args...]\n"
        "Required env: OUTPUT_DIR (writable dir for the sandboxed child).\n"
        "See libexec/raptor-run-sandboxed docstring for details."
    )
    print(usage, file=sys.stderr)
    sys.exit(0 if len(sys.argv) >= 2 else 1)

cmd = sys.argv[1:]

# OUTPUT_DIR must be explicit — the former fallback to /tmp gave callers
# the illusion of isolation when they forgot to set it (the child could
# still write anywhere in shared /tmp).
output_dir = os.environ.get("OUTPUT_DIR")
if not output_dir:
    _die("OUTPUT_DIR env var must be set to a writable dir for the sandboxed child")

# Validate the OUTPUT_DIR shape before handing it to Landlock.
# Pre-fix any string went straight to `output=output_dir` —
# a value containing newlines / NULs / shell metas would either
# blow up Landlock with an opaque kernel error or, worse, silently
# pass through (Landlock accepts any string but the bind-mount
# fallback path didn't). Concrete failures the validation catches:
#
# * `OUTPUT_DIR=` (empty value, somehow set but empty) — the
#   `if not output_dir` above catches this; belt-and-braces here.
# * `OUTPUT_DIR=/nonexistent/parent/leaf` — Landlock errors with
#   "writable path could not be opened"; caller sees a sandbox
#   error instead of "your OUTPUT_DIR doesn't exist".
# * `OUTPUT_DIR=/tmp/foo\n/etc/passwd` (newline injection from
#   a shell var that captured user input) — Landlock open on
#   the literal-with-newline path likely errors, but better to
#   reject up-front with a clear message.
# * Non-absolute path — relative to where? The mount-ns child
#   pivots root, so `out/foo` opens under the new rootfs (which
#   doesn't have `out/`). Reject relative paths with a hint.
if "\x00" in output_dir or "\n" in output_dir or "\r" in output_dir:
    _die("OUTPUT_DIR contains control bytes (NUL / newline / CR); refusing")
if not os.path.isabs(output_dir):
    _die(f"OUTPUT_DIR must be an absolute path (got {output_dir!r})")
# Resolve & ensure parent exists. The dir itself may not exist
# yet — Landlock will create it if absent; that's fine.
output_dir_resolved = os.path.realpath(output_dir)
if not os.path.isdir(os.path.dirname(output_dir_resolved)):
    _die(
        f"OUTPUT_DIR parent does not exist: "
        f"{os.path.dirname(output_dir_resolved)!r}"
    )
output_dir = output_dir_resolved

# basicConfig sets the root logger at WARNING so unrelated modules stay
# quiet, then we raise ONLY core.sandbox to INFO so its enforcement
# diagnostics (network blocked, write denied, etc.) reach stderr. Without
# this scoping, every RAPTOR module's INFO logs would flood the child's
# stderr — and this script is what the LLM calls as a subprocess.
logging.basicConfig(level=logging.WARNING, format="%(message)s", stream=sys.stderr)
logging.getLogger("core.sandbox").setLevel(logging.INFO)

from core.sandbox import sandbox, SandboxSetupError, SANDBOX_ENGAGE_EXIT_CODE  # noqa: E402

# Child wall-clock limit. 1800s default: long enough for typical
# configure/make cycles, short enough that a wedged untrusted build
# doesn't pin the host for hours. Too low breaks legitimate large/ASAN
# builds (raise via RAPTOR_SANDBOX_TIMEOUT per run); too high delays
# the fail-loud signal on a hung child — hence env-tunable, validated,
# never unbounded.
_timeout_raw = os.environ.get("RAPTOR_SANDBOX_TIMEOUT", "")
if _timeout_raw:
    if not _timeout_raw.isdigit() or int(_timeout_raw) <= 0:
        _die(
            f"RAPTOR_SANDBOX_TIMEOUT must be a positive integer "
            f"number of seconds (got {_timeout_raw!r})"
        )
    child_timeout = int(_timeout_raw)
else:
    child_timeout = 1800

try:
    with sandbox(block_network=True,
                 target=os.getcwd(),
                 output=output_dir) as run:
        # Run with captured stderr so _check_blocked can inspect it,
        # but print it through so the caller sees it too.
        result = run(cmd, capture_output=True, text=True,
                     timeout=child_timeout)

        # Pass through child output
        if result.stdout:
            sys.stdout.write(result.stdout)
            sys.stdout.flush()
        if result.stderr:
            sys.stderr.write(result.stderr)
            sys.stderr.flush()

        # Surface sandbox diagnostics for the caller
        info = result.sandbox_info
        if info.get("crashed"):
            print(f"[sandbox] {info.get('evidence', 'Process crashed')}", file=sys.stderr)
        elif info.get("resource_exceeded"):
            print(f"[sandbox] {info.get('evidence', 'Resource limit exceeded')}", file=sys.stderr)
        if info.get("blocked"):
            for item in info["blocked"]:
                print(f"[sandbox] {item}", file=sys.stderr)
except SandboxSetupError as e:
    _die(f"sandbox isolation could not engage: {e}", code=SANDBOX_ENGAGE_EXIT_CODE)
except subprocess.TimeoutExpired as e:
    # The run() backstop (child_timeout above) raises TimeoutExpired, not
    # OSError — without this clause a hung child produced a raw traceback
    # and exit 1 instead of the documented `[sandbox] ERROR` + exit 2.
    # The exception carries whatever the child wrote before the kill;
    # pass it through so partial output isn't discarded.
    for stream, data in ((sys.stdout, e.output), (sys.stderr, e.stderr)):
        if data:
            stream.write(data if isinstance(data, str)
                         else data.decode("utf-8", errors="replace"))
            stream.flush()
    _die(f"sandbox invocation failed: {e.__class__.__name__}: {e}", code=2)
except (OSError, RuntimeError, ValueError) as e:
    _die(f"sandbox invocation failed: {e.__class__.__name__}: {e}", code=2)

sys.exit(result.returncode)
